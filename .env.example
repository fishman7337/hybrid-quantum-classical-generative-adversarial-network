# Local environment template for HQCGAN research.
# Copy to .env and edit locally. Do not commit .env.

HQCGAN_ENV=development
HQCGAN_RANDOM_SEED=42

# Local paths
HQCGAN_DATA_DIR=data
HQCGAN_RAW_DATA_DIR=data/raw
HQCGAN_PROCESSED_DATA_DIR=data/processed
HQCGAN_MODEL_DIR=models
HQCGAN_REPORT_DIR=reports
HQCGAN_FIGURE_DIR=reports/figures

# Experiment defaults
HQCGAN_DATASET=mnist-binary-0-1
HQCGAN_EPOCHS=150
HQCGAN_BATCH_SIZE=64
HQCGAN_FID_SAMPLES=500
HQCGAN_QUBITS=3,5,7

# Optional tracking integrations
MLFLOW_TRACKING_URI=
WANDB_PROJECT=
WANDB_API_KEY=
